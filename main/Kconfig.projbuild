menu "Example Configurations"
    config EXAMPLE_ENABLE_SD_CARD
        bool "Enable SD Card"
        default n
        help 
            Enabling this option will initialize the SD card, so the SD card needs to be inserted into the slot. Additionally, if using the Video Player example, an MJPEG format video must be saved on the SD card.

    config EXAMPLE_ENABLE_APP_CALCULATOR
        bool "Enable Calculator App"
        default n
        help
            Enabling this option will compile and install the Calculator app.
            Keep it disabled to reduce the factory app partition usage.

    config EXAMPLE_ENABLE_APP_GAME_2048
        bool "Enable 2048 Game App"
        default n
        help
            Enabling this option will compile and install the 2048 game app.
            Keep it disabled to reduce the factory app partition usage.

    config EXAMPLE_ENABLE_APP_FINGERPRINT
        bool "Enable Fingerprint App"
        default y
        help
            Enabling this option will compile and install the AS608 fingerprint app.
            Disable it before enabling the temporary AS608 validation task.

    config EXAMPLE_ENABLE_APP_ENVIRONMENT_MONITOR
        bool "Enable Environment Monitor App"
        default y
        help
            Enabling this option will compile and install the Environment Monitor app.
            The app displays DHT11 and MQ-2 service snapshots on the device screen.

    config EXAMPLE_ENABLE_AS608_VALIDATION
        bool "Enable AS608 hardware validation task"
        depends on !EXAMPLE_ENABLE_APP_FINGERPRINT
        default n
        help
            Enabling this option starts a serial-log AS608 validation task at boot.
            Keep it disabled outside temporary fingerprint hardware validation.
            Disable the Fingerprint app first because both paths use the same AS608 service.

    config EXAMPLE_ENABLE_DHT11_SERVICE
        bool "Enable DHT11 temperature and humidity service"
        default y
        help
            Enabling this option starts the DHT11 periodic sampling service at boot.
            The first version only logs samples and exposes a snapshot query API.

    if EXAMPLE_ENABLE_DHT11_SERVICE
        config EXAMPLE_DHT11_DATA_GPIO
            int "DHT11 DATA GPIO"
            range 0 54
            default 32
            help
                ESP32-P4 GPIO connected to DHT11 DATA. Use an external 4.7k-10k pull-up to 3.3V.

        config EXAMPLE_DHT11_SAMPLE_PERIOD_MS
            int "DHT11 sample period in milliseconds"
            range 2000 60000
            default 2000
            help
                DHT11 should not be sampled faster than once every 2 seconds.

        config EXAMPLE_DHT11_MAX_CONSECUTIVE_FAILURES
            int "DHT11 consecutive failure threshold"
            range 1 20
            default 3
            help
                Log an error after this many consecutive sample failures.

        config EXAMPLE_DHT11_TASK_STACK_SIZE
            int "DHT11 task stack size"
            range 2048 8192
            default 3072
            help
                Stack size for the DHT11 periodic sampling task.

        config EXAMPLE_DHT11_TASK_PRIORITY
            int "DHT11 task priority"
            range 1 10
            default 4
            help
                FreeRTOS priority for the DHT11 periodic sampling task.
    endif

    config EXAMPLE_ENABLE_MQ2_SERVICE
        bool "Enable MQ-2 gas alarm service"
        default y
        help
            Enabling this option starts the MQ-2 digital alarm sampling service at boot.
            The first version reads the module DO threshold output only; AO analog
            sampling is reserved for a later calibrated extension.

    if EXAMPLE_ENABLE_MQ2_SERVICE
        config EXAMPLE_MQ2_DO_GPIO
            int "MQ-2 DO GPIO"
            range 0 54
            default 33
            help
                ESP32-P4 GPIO connected to MQ-2 DO. Confirm the module output level
                is safe for the ESP32-P4 input before wiring.

        config EXAMPLE_MQ2_ALARM_LEVEL
            int "MQ-2 alarm active level"
            range 0 1
            default 0
            help
                Digital level treated as alarm. Many MQ-2 modules drive DO low when
                the comparator threshold is exceeded, but module boards can differ.

        config EXAMPLE_MQ2_SAMPLE_PERIOD_MS
            int "MQ-2 sample period in milliseconds"
            range 100 60000
            default 500
            help
                Period for reading the MQ-2 DO level.

        config EXAMPLE_MQ2_WARMUP_MS
            int "MQ-2 warmup period in milliseconds"
            range 0 600000
            default 30000
            help
                Ignore alarm output during sensor warmup. MQ-2 sensors need a warmup
                period after power-on, and production deployments may need a longer value.

        config EXAMPLE_MQ2_CONFIRM_SAMPLES
            int "MQ-2 debounce confirmation samples"
            range 1 100
            default 3
            help
                Number of consecutive samples required before entering or leaving alarm state.

        config EXAMPLE_MQ2_TASK_STACK_SIZE
            int "MQ-2 task stack size"
            range 2048 8192
            default 3072
            help
                Stack size for the MQ-2 periodic sampling task.

        config EXAMPLE_MQ2_TASK_PRIORITY
            int "MQ-2 task priority"
            range 1 10
            default 4
            help
                FreeRTOS priority for the MQ-2 periodic sampling task.
    endif

    if EXAMPLE_ENABLE_AS608_VALIDATION || EXAMPLE_ENABLE_APP_FINGERPRINT
        config EXAMPLE_AS608_UART_NUM
            int "AS608 UART port"
            range 1 4
            default 1
            help
                UART0 is reserved for the console; use an available HP UART port for AS608.

        config EXAMPLE_AS608_TX_GPIO
            int "AS608 UART TX GPIO"
            default 14
            help
                ESP32-P4 GPIO connected to AS608 RX.

        config EXAMPLE_AS608_RX_GPIO
            int "AS608 UART RX GPIO"
            default 15
            help
                ESP32-P4 GPIO connected to AS608 TX.

        config EXAMPLE_AS608_BAUD_RATE
            int "AS608 UART baud rate"
            default 57600
            help
                AS608 factory default is commonly 57600 bps.

        config EXAMPLE_AS608_ADDRESS
            hex "AS608 device address"
            default 0xFFFFFFFF
            help
                AS608 factory default device address.

        config EXAMPLE_AS608_READ_TIMEOUT_MS
            int "AS608 UART read timeout in milliseconds"
            default 300
            help
                Per-read UART timeout used by the AS608 port adapter.
    endif

    if EXAMPLE_ENABLE_AS608_VALIDATION
        config EXAMPLE_AS608_VALIDATION_START_DELAY_MS
            int "AS608 validation start delay in milliseconds"
            default 5000
            help
                Delay before the validation task starts, allowing boot logs to settle.

        config EXAMPLE_AS608_VALIDATION_STEP_DELAY_MS
            int "AS608 validation step delay in milliseconds"
            default 3000
            help
                Delay before one-shot identify/match steps, giving the operator time to place or remove a finger.

        config EXAMPLE_AS608_VALIDATION_DELETE_ENROLLED
            bool "Delete enrolled template after validation"
            default n
            help
                Delete the template page enrolled by this validation run after all checks complete.
    endif
endmenu
