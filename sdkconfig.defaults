CONFIG_EXAMPLE_CLASSROOM_SCHEDULE_SERVER_HOST="192.168.1.100"
CONFIG_EXAMPLE_CLASSROOM_SCHEDULE_SERVER_PORT=8080
CONFIG_EXAMPLE_CLASSROOM_SCHEDULE_API_PATH="/classroom-schedule/today"
CONFIG_EXAMPLE_CLASSROOM_SCHEDULE_TOKEN="change-me"
CONFIG_EXAMPLE_CLASSROOM_SCHEDULE_REFRESH_MS=600000
CONFIG_EXAMPLE_CLASSROOM_SCHEDULE_REQUEST_TIMEOUT_MS=8000
CONFIG_EXAMPLE_ENABLE_DHT11_SERVICE=y
CONFIG_EXAMPLE_DHT11_DATA_GPIO=32
CONFIG_EXAMPLE_DHT11_SAMPLE_PERIOD_MS=2000
CONFIG_EXAMPLE_DHT11_MAX_CONSECUTIVE_FAILURES=3
