CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_EXAMPLE_ENABLE_SD_CARD=y
CONFIG_EXAMPLE_ENABLE_APP_CALCULATOR=n
CONFIG_EXAMPLE_ENABLE_APP_GAME_2048=n
CONFIG_EXAMPLE_ENABLE_APP_MUSIC_PLAYER=n
CONFIG_EXAMPLE_ENABLE_APP_VIDEO_PLAYER=n
CONFIG_EXAMPLE_ENABLE_APP_ENVIRONMENT_MONITOR=y
